<?xml version="1.0" encoding="UTF-8"?>
<!--
================================================================================
RUN_SET: 测序运行集合
================================================================================
一个EXPERIMENT可产生多个RUN，每个RUN代表一次实际的测序运行/数据文件
================================================================================
-->
<RUN_SET xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!--
  ============================================================================
  RUN: 单个测序运行 (以SRR38604304为例)
  ============================================================================
  属性说明:
  - accession: SRA分配的运行唯一ID (SRR开头 = Run)
  - alias: 运行别名/原始文件名
  -->
  <RUN accession="SRR38604304" alias="YMHF22_A22_R1.fastq">

    <!--
    ==========================================================================
    IDENTIFIERS: 运行的多重标识符
    ==========================================================================
    -->
    <IDENTIFIERS>
      <!-- PRIMARY_ID: SRA系统分配的主ID -->
      <PRIMARY_ID>SRR38604304</PRIMARY_ID>

      <!--
      SUBMITTER_ID: 提交者定义的ID
      - namespace: 提交者ID命名空间 (SUB16135400)
      - label: 标签编号
      -->
      <SUBMITTER_ID namespace="SUB16135400" label="9">YMHF22_A22_R1.fastq</SUBMITTER_ID>
    </IDENTIFIERS>

    <!--
    ==========================================================================
    EXPERIMENT_REF: 关联的实验
    ==========================================================================
    - accession: 实验的SRA accession (SRX号)
    -->
    <EXPERIMENT_REF accession="SRX33410541">
      <IDENTIFIERS>
        <SUBMITTER_ID namespace="SUB16135400">NS109-31_S31</SUBMITTER_ID>
      </IDENTIFIERS>
    </EXPERIMENT_REF>

  </RUN>

  <!--
  ============================================================================
  RUN_SET包含20个RUN，完整对应关系:
  ============================================================================
  SRR38604304 -> SRX33410541 (YMHF22_A22)
  SRR38604305 -> SRX33410540 (YMHF13_E29)
  SRR38604306 -> SRX33410539 (YMHF13_D29)
  SRR38604307 -> SRX33410538 (YMHF13_C29)
  SRR38604308 -> SRX33410537 (YMHF13_B29)
  SRR38604309 -> SRX33410536 (YMHF13_A29)
  SRR38604310 -> SRX33410535 (YMHF12_D29)
  SRR38604311 -> SRX33410534 (YMHF12_C29)
  SRR38604312 -> SRX33410533 (YMHF_72_0)
  SRR38604313 -> SRX33410532 (YMHF_32_0)
  SRR38604314 -> SRX33410531 (YMHF_31_0)
  SRR38604315 -> SRX33410530 (YMHF23_D22)
  SRR38604316 -> SRX33410529 (YMHF23_C22)
  SRR38604317 -> SRX33410528 (YMHF23_B22)
  SRR38604318 -> SRX33410527 (YMHF23_A22)
  SRR38604319 -> SRX33410526 (YMHF22_C22)
  SRR38604320 -> SRX33410525 (YMHF22_B22)
  SRR38604321 -> SRX33410524 (YMHF12_B29)
  SRR38604322 -> SRX33410523 (YMHF12_A29)

  注: alias字段中的_R1表示双端测序的Read 1文件
  ============================================================================
  -->

</RUN_SET>
