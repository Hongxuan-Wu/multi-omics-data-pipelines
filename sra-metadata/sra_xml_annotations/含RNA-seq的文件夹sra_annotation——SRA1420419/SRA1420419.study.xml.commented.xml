<!-- ============================================================ -->
<!-- SRA研究元数据文件 (Study Metadata)                           -->
<!-- 描述研究项目的总体信息，包括标题、摘要、研究类型等           -->
<!-- 关键字段：                                                   -->
<!--   - accession: SRA研究访问号 (SRP格式)                       -->
<!--   - EXTERNAL_ID: BioProject访问号 (PRJNA格式)                -->
<!--   - STUDY_TITLE: 研究项目的正式标题                          -->
<!--   - STUDY_ABSTRACT: 研究内容摘要                            -->
<!-- ============================================================ -->
<?xml version="1.0" encoding="UTF-8"?>
<!-- 研究集合：包含多个研究项目记录 -->
<STUDY_SET xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- 单个研究记录：描述一个研究项目 -->
    <!-- SRA研究访问号: SRP375270 -->
  <STUDY center_name="BioProject" alias="PRJNA838128" accession="SRP375270">
    <!-- 标识符块：包含各种唯一标识符 -->
    <IDENTIFIERS>
      <!-- 主标识符：SRA分配的唯一访问号（如SRX、SRR、SRS、SRP等） -->
      <PRIMARY_ID>SRP375270</PRIMARY_ID>
      <!-- 外部标识符：关联到其他数据库的标识符（如BioProject、BioSample） -->
        <!-- BioProject: NCBI生物项目数据库 -->
      <EXTERNAL_ID namespace="BioProject" label="primary">PRJNA838128</EXTERNAL_ID>
    </IDENTIFIERS>
    <!-- 研究描述：研究项目的详细描述信息 -->
    <DESCRIPTOR>
      <!-- 研究标题：研究项目的正式标题 -->
      <STUDY_TITLE>Homo sapiens Transcriptome or Gene expression</STUDY_TITLE>
      <!-- 研究类型：研究的性质分类 -->
      <STUDY_TYPE existing_study_type="Other"/>
      <!-- 研究摘要：研究内容的简要概述 -->
      <STUDY_ABSTRACT>Identification of plasma miRNAs as prenatal biomarkers for nonsyndromic cleft lip with palate by RNA sequencing analyses</STUDY_ABSTRACT>
      <!-- 中心项目名称：研究机构内部的项目名称 -->
      <CENTER_PROJECT_NAME>Homo sapiens</CENTER_PROJECT_NAME>
    </DESCRIPTOR>
  </STUDY>
</STUDY_SET>
